# TLS önde (yük dengeleyici) sonlanıyorsa gelen X-Forwarded-Proto korunur, yoksa bu bağlantının şeması kullanılır.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # Backend dosya yükleme sınırı 21 MB.
    client_max_body_size 21m;

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        # Firma veri dışa aktarımı büyük firmada 100 sn sürebiliyor.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        # Backend aynı başlıkları kendisi gönderir; çift başlık olmasın.
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Derlenmiş dosyaların adı içeriğe göre değişir; uzun süre önbelleklenebilir.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # Yeni sürüm hemen görünsün diye sayfa ve service worker önbelleklenmez.
    location = /sw.js {
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
    }

    location / {
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri /index.html;
    }
}
