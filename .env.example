SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/blackrose
DB_USERNAME=blackrose
DB_PASSWORD=
TENANCY_BASE_DOMAIN=localhost
FRONTEND_BASE_URL=http://localhost:5173
FILES_ROOT=./data/files

# Ters vekil (nginx, ALB...) arkasında native yapılmalı; IP sınırı ve denetim günlüğü buna bağlıdır.
FORWARD_HEADERS_STRATEGY=none

# local veya s3. Ayrıntı: docs/URETIM_KURULUM.md
FILE_STORAGE=local
S3_BUCKET=
S3_REGION=eu-central-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# none veya clamav. stage/prod varsayılanı clamav'dır.
FILE_SCAN_MODE=none
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# dev dışındaki profillerde zorunlu; en az 32 bayt olmalı.
JWT_SECRET=
TOTP_ENCRYPTION_KEY=

# İlk SaaS yöneticisi. Kayıt yoksa açılışta oluşturulur.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# dev dışında varsayılan true: SaaS yöneticisi 2FA kurmadan giriş yapamaz.
SAAS_2FA_REQUIRED=false

# IP başına dakikalık sınırlar.
RATE_LIMIT_LOGIN=30
RATE_LIMIT_PASSWORD_RESET=10
RATE_LIMIT_REFRESH=300

# stage/prod'da SMTP zorunlu.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=noreply@blackrose.local
MAIL_AUTH=true
MAIL_STARTTLS=true
